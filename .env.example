# Names only. Never put real values in this file and never commit a real .env.
#
# On GitHub these are repository secrets:
#   Settings > Secrets and variables > Actions > New repository secret
# For a local run, export them in your shell, or copy this file to .env and
# load it yourself. .env is in .gitignore.

# Required. The Telegram bot that posts, from @BotFather.
TELEGRAM_TOKEN=123456789:replace-with-the-bot-token

# Required. The channel or chat to post to. Channel ids start with -100.
TELEGRAM_CHAT_ID=-1000000000000

# Required. The SEC blocks requests that do not identify a real person.
# Format: your name, then your email.
SEC_USER_AGENT=Your Name you@example.com

# Optional. Free key from finnhub.io. Turns on the $300M market cap floor
# for insider buys and an earnings calendar fallback. Leave empty to run
# without either, which is how the live bot runs today.
FINNHUB_KEY=

# Optional. Set to 1 to try the Senate disclosure site. It refuses GitHub's
# servers, so this stays off.
SENATE_ENABLED=
